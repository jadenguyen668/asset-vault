# Copy this file to .env.local before building the ZPS Docker image.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

R2_WORKER_URL=https://your-worker.workers.dev
R2_WORKER_SECRET=your-shared-secret

ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# LiveDeploy profile: conversion must stay disabled on ZPS.
NEXT_PUBLIC_SPINE_CONVERT_ENABLED=false
SPINE_CLI_PATH=
